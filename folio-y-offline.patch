+/* ---------- Identificador interno (discreto, no se muestra al cliente) ----------
+   El folio de arriba (V-VEND-FECHA-###) se sigue generando exactamente
+   igual que siempre para el ticket. Pero como el consecutivo "###" vive en
+   el localStorage de CADA celular, dos vendedores (o el mismo vendedor en
+   dos celulares) pueden producir el MISMO folio el mismo día si ambos
+   están sin señal y ninguno ve el consecutivo del otro. Eso no se nota en
+   el ticket, pero si el folio se usa como llave (en Firestore o en el
+   Sheet) una venta pisa a la otra.
+   Por eso cada venta lleva además un idInterno, único de verdad porque
+   combina un id de dispositivo (se genera una sola vez por celular y se
+   queda guardado) + la hora exacta + un azar corto. Ese es el que se usa
+   como llave real; el folio sigue siendo el mismo para el cliente. */
+function _idDispositivoVenta(){
+  const clave = "id_dispositivo_venta";
+  let id = localStorage.getItem(clave);
+  if (!id) {
+    id = Math.random().toString(36).slice(2, 8).toUpperCase() + Date.now().toString(36).toUpperCase();
+    localStorage.setItem(clave, id);
+  }
+  return id;
+}
+function generarIdInternoVenta(){
+  return _idDispositivoVenta() + "-" + Date.now().toString(36) + "-" + Math.random().toString(36).slice(2, 6);
+}
  
